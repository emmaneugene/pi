{
  "lastChangelogVersion": "0.86.0",
  "defaultProvider": "opencode-go",
  "defaultModel": "glm-5.3-flash",
  "hideThinkingBlock": false,
  "defaultThinkingLevel": "high",
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "cursor/default",
    "cursor/grok-4.6",
    "cursor/claude-fable-5-1",
    "cursor/claude-opus-5",
    "cursor/gemini-3.8-flash",
    "cursor/muse-spark-1.3",
    "opencode-go/deepseek-v4.1-flash",
    "opencode-go/glm-5.3-flash",
    "opencode-go/kimi-k2.7-code",
    "opencode-go/kimi-k3",
    "opencode-go/muse-spark-1.3-contributor",
    "openrouter/anthropic/claude-fable-5.1",
    "openrouter/anthropic/claude-fable-5.1:batch"
  ],
  "skills": ["~/.agents/skills"],
  "shellPath": "/bin/zsh",
  "packages": [
    "npm:@emmaneugene/pi-cursor-sdk",
    "npm:@ff-labs/pi-fff",
    "npm:@plannotator/pi-extension",
    "npm:pi-mcp-adapter",
    "npm:pi-web-providers"
  ],
  "doubleEscapeAction": "tree",
  "externalEditor": "zed --wait",
  "treeFilterMode": "no-tools",
  "theme": "light/dark",
  "transport": "auto",
  "enableSkillCommands": false,
  "collapseChangelog": true,
  "enableInstallTelemetry": true,
  "defaultProjectTrust": "always",
  "terminal": {
    "imageWidthCells": 60,
    "showTerminalProgress": true
  },
  "autocompleteMaxVisible": 5,
  "showCacheMissNotices": true,
  "warnings": {
    "anthropicExtraUsage": false
  },
  "compaction": {
    "enabled": false,
    "reserveTokens": 16384
  },
  "outputPad": 1,
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "always",
  "fullscreenExitOutput": "transcript",
  "fullscreenCopyOnSelect": true,
  "markdown": {
    "mermaid": "streaming"
  },
  "quietStartup": false
}
