{
  "plannotator-auto-close": "0",
  "plannotator-color-theme": "plannotator",
  "plannotator-conventional-comments": "false",
  "plannotator-default-diff-type": "unstaged",
  "plannotator-diff-font-family": "",
  "plannotator-diff-font-size": "",
  "plannotator-diff-hide-whitespace": "false",
  "plannotator-diff-indicators": "bars",
  "plannotator-diff-line-bg-intensity": "subtle",
  "plannotator-diff-line-diff-type": "word-alt",
  "plannotator-diff-overflow": "scroll",
  "plannotator-diff-show-background": "true",
  "plannotator-diff-show-line-numbers": "true",
  "plannotator-diff-style": "split",
  "plannotator-diff-tab-size": "2",
  "plannotator-filebrowser-dirs": "[]",
  "plannotator-filebrowser-enabled": "true",
  "plannotator-identity": "nitwit",
  "plannotator-input-method": "drag",
  "plannotator-plan-ai-announcement-seen": "1",
  "plannotator-plan-width": "default",
  "plannotator-quick-labels": "[]",
  "plannotator-sticky-actions-enabled": "true",
  "plannotator-tater-mode": "false",
  "plannotator-theme": "light",
  "plannotator-toc-enabled": "true"
}
